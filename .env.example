# Placeholder values only. Keep real credentials in the ignored .env.local file.
DATABASE_URL=
TEST_DATABASE_URL=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# Google Gemini/OpenAI-compatible embeddings endpoint configuration.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BATCH_SIZE=32

# Answer generation. Google host selects the native Gemini generateContent adapter.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/
AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=45000
AI_RETRY_ATTEMPTS=3

CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# Member 2 (application layer)
# Set these only for the out-of-band administrator bootstrap script.
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=604800
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Optional public GitHub Release source. A token is optional for public repositories.
GITHUB_OWNER=mutturaj-angadi
GITHUB_REPO=Research-IQ
GITHUB_TOKEN=
GITHUB_RELEASE_MAX_ASSET_SIZE_MB=20
