{
  "name": "researchiq",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ResearchIQ: Next.js application (Member 2) on top of the database and semantic-search layer (Member 1)",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:down": "tsx scripts/migrate.ts --down",
    "seed": "tsx scripts/seed-database.ts",
    "embed": "tsx scripts/generate-embeddings.ts",
    "ingest": "tsx scripts/ingest-papers.ts",
    "reindex": "tsx scripts/reindex.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "next": "^15.1.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.29"
    },
    "@mapbox/node-pre-gyp": {
      "tar": "^7.5.22"
    },
    "minimatch": "11.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
